SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Search / SEO
# Keep false while the maintenance page is live. Set true only for the public launch.
SEO_INDEXING_ENABLED=false
# Paste only the Search Console verification token, not the full meta tag.
GOOGLE_SITE_VERIFICATION=YOUR_GOOGLE_SITE_VERIFICATION_TOKEN

# Transactional email (Resend)
RESEND_API_KEY=YOUR_RESEND_API_KEY
LIDYA_FROM_EMAIL=LIDYA Jewellery <info@lidyaalbaresort.com>
LIDYA_NOTIFICATION_EMAIL=info@lidyaalbaresort.com
